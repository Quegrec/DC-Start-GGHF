## Local dev (docker-compose Postgres)
# Matches docker-compose.yml:
# - user: postgres
# - password: postgres
# - db: dcstartgghf
# - port: 5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dcstartgghf?schema=public"

## Auth
# Used by NextAuth. Generate a strong value for real deployments.
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

## Demo login (seeded user password)
DEMO_LOGIN_PASSWORD="change-me"

## RAWG API (video game catalog)
# Create a free key: https://rawg.io/apidocs
RAWG_API_KEY=""
RAWG_PAGE_SIZE="20"

